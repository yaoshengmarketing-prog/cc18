{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cc18.invalid/schemas/content-brief.schema.json",
  "title": "CC18 Content Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["movie_id", "primary_angle", "avoid_angles", "canonical_tags", "editorial_tags", "source_snapshot_hash", "taxonomy_version"],
  "properties": {
    "movie_id": {"type": "string"},
    "primary_angle": {"type": "string", "minLength": 10},
    "secondary_angle": {"type": ["string", "null"]},
    "avoid_angles": {"type": "array", "items": {"type": "string"}},
    "canonical_tags": {"type": "array", "items": {"$ref": "#/$defs/assignment"}},
    "editorial_tags": {"type": "array", "items": {"$ref": "#/$defs/assignment"}},
    "candidate_tags": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "source_snapshot_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "taxonomy_version": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "assignment": {
      "type": "object",
      "required": ["id", "evidence", "confidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "evidence": {"type": "string", "minLength": 5},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "label", "definition", "evidence", "confidence", "status"],
      "properties": {
        "candidate_id": {"type": "string"},
        "label": {"type": "string"},
        "definition": {"type": "string"},
        "evidence": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"const": "provisional"}
      },
      "additionalProperties": false
    }
  }
}

