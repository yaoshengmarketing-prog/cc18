{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cc18.invalid/schemas/video-analysis.schema.json",
  "title": "CC18 Local Video Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "movie_id", "job_id", "generated_at", "analysis_status", "execution", "model", "source_duration_seconds", "coverage", "visual_observations", "audio_transcription_status", "source_frames_embedded", "secrets_persisted"],
  "properties": {
    "schema_version": {"const": 1},
    "movie_id": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "job_id": {"type": "string", "format": "uuid"},
    "generated_at": {"type": "string", "format": "date-time"},
    "analysis_status": {"const": "analysis_ready"},
    "execution": {"const": "local_only"},
    "model": {"type": "string", "minLength": 1},
    "source_duration_seconds": {"type": "number", "minimum": 0},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_windows", "average_confidence", "timeline_start_seconds", "timeline_end_seconds"],
      "properties": {
        "sample_windows": {"type": "integer", "minimum": 1},
        "average_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "timeline_start_seconds": {"type": ["number", "null"], "minimum": 0},
        "timeline_end_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "visual_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_index", "source_start_seconds", "source_end_seconds", "setting", "narrative_cues", "interaction_tone", "camera_style", "non_graphic_tags", "continuity_notes", "confidence"],
        "properties": {
          "sample_index": {"type": "integer", "minimum": 0},
          "source_start_seconds": {"type": "number", "minimum": 0},
          "source_end_seconds": {"type": "number", "minimum": 0},
          "setting": {"type": "string", "maxLength": 500},
          "narrative_cues": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 120}},
          "interaction_tone": {"type": "string", "maxLength": 500},
          "camera_style": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 120}},
          "non_graphic_tags": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 120}},
          "continuity_notes": {"type": "string", "maxLength": 500},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "audio_transcription_status": {"enum": ["not_configured", "ready", "failed"]},
    "source_frames_embedded": {"const": false},
    "secrets_persisted": {"const": false}
  }
}
