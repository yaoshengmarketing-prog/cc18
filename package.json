{
  "name": "cc18",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/astro-build.mjs",
    "preview": "astro preview",
    "check": "node scripts/astro-check.mjs",
    "registry:validate": "node scripts/validate-registry.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "source:test": "node --test tests/cc18-parser.test.mjs",
    "media:test": "node --test tests/media-function.test.mjs",
    "validate": "npm run registry:validate && npm run content:validate && npm run taxonomy:test && npm run workflow:test && npm run editorial:policy:test && npm run source:test && npm run media:test && npm run bridge:test && npm run worker:test && npm run discovery:test && npm run d1:test && npm run canary:test && npm run r2:auth:test && npm run editorial:provider:test && npm run editorial:safety:test && npm run editorial:local-source:test && npm run editorial:normalization:test && npm run editorial:qa-rules:test && npm run editorial:search:test && npm run image:provider:test && npm run video:props:test && npm run publisher:test && npm run build",
    "taxonomy:test": "node --test tests/tag-taxonomy-v3.test.mjs tests/topic-elements.test.mjs",
    "workflow:test": "node --test tests/agent-workflow.test.mjs tests/github-canary-workflow.test.mjs tests/editorial-draft-canary.test.mjs tests/editorial-rehydrate.test.mjs",
    "editorial:policy:test": "node --test tests/editorial-policy-v3.test.mjs",
    "source:ingest": "node scripts/source/ingest-one.mjs",
    "discovery:run": "node scripts/discovery/run.mjs",
    "queue:status": "node scripts/queue/status.mjs",
    "queue:claim": "node scripts/queue/claim.mjs",
    "queue:finish": "node scripts/queue/finish.mjs",
    "canary:health": "node scripts/canary/health.mjs",
    "canary:repair": "node scripts/canary/health.mjs --repair-expired",
    "canary:run": "node scripts/canary/run.mjs",
    "canary:test": "node --test tests/canary-queue.test.mjs",
    "r2:auth:test": "node --test tests/r2-auth.test.mjs",
    "bridge:init": "node scripts/bridge/init.mjs",
    "bridge:login": "node scripts/bridge/login.mjs",
    "bridge:preflight": "node scripts/bridge/preflight.mjs",
    "bridge:enqueue": "node scripts/bridge/enqueue.mjs",
    "bridge:process-one": "node scripts/bridge/process-one.mjs",
    "bridge:d1:process-one": "node scripts/bridge/process-d1-one.mjs",
    "bridge:analyze-one": "node scripts/bridge/analyze-one.mjs",
    "bridge:cleanup": "node scripts/bridge/cleanup.mjs",
    "bridge:cleanup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bridge/install-cleanup-task.ps1",
    "bridge:test": "node --test tests/media-bridge.test.mjs",
    "worker:cycle": "node scripts/worker/run-cycle.mjs",
    "worker:readiness": "node scripts/worker/readiness.mjs",
    "worker:schedule:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/worker/install-cycle-task.ps1",
    "worker:test": "node --test tests/worker-cycle.test.mjs",
    "discovery:test": "node --test tests/discovery-queue.test.mjs",
    "d1:test": "node --test tests/d1-migration.test.mjs",
    "editorial:build": "node scripts/editorial/build-from-analysis.mjs",
    "editorial:repair": "node scripts/editorial/build-from-analysis.mjs --source-only --repair-existing",
    "editorial:qa": "node scripts/editorial/qa-draft.mjs",
    "editorial:provider:test": "node --test tests/editorial-provider.test.mjs",
    "editorial:safety:test": "node --test tests/editorial-safe-payload.test.mjs",
    "editorial:local-source:test": "node --test tests/editorial-local-source-brief.test.mjs",
    "editorial:normalization:test": "node --test tests/editorial-provider-normalization.test.mjs",
    "editorial:qa-rules:test": "node --test tests/editorial-qa-rules.test.mjs tests/editorial-approval.test.mjs",
    "editorial:search:test": "node --test tests/editorial-search-content.test.mjs",
    "image:provider:test": "node --test tests/image-provider.test.mjs",
    "image:provider:smoke": "node scripts/image/provider-smoke.mjs",
    "image:d1:process-one": "node scripts/image/process-d1-one.mjs",
    "image:d1:finalize-existing": "node scripts/image/finalize-d1-existing.mjs",
    "image:cycle": "node scripts/image/run-image-cycle.mjs",
    "image:finalize": "node scripts/image/finalize-assets.mjs",
    "editorial:provider:smoke": "node scripts/editorial/provider-smoke.mjs",
    "editorial:d1:handoff": "node scripts/editorial/handoff-d1.mjs",
    "editorial:d1:source-only": "node scripts/editorial/handoff-d1.mjs --source-only",
    "editorial:source-cycle": "node scripts/editorial/run-source-cycle.mjs",
    "editorial:draft-canary": "node scripts/editorial/draft-canary-d1.mjs",
    "editorial:d1:finalize-qa": "node scripts/editorial/finalize-qa-d1.mjs",
    "video:studio": "remotion studio video/src/index.ts --no-open",
    "video:still": "remotion still video/src/index.ts CC18Vertical video/out/preview.png --frame=120 --props=video/examples/demo.json",
    "video:render:snos-360": "remotion render video/src/index.ts CC18Vertical video/out/snos-360.mp4 --props=video/examples/snos-360.json",
    "video:render:huntc-568": "remotion render video/src/index.ts CC18Vertical video/out/huntc-568.mp4 --props=video/examples/huntc-568.json",
    "video:still:sdab-358": "remotion still video/src/index.ts CC18Vertical video/out/sdab-358-preview.png --frame=120 --props=video/examples/sdab-358.json",
    "video:render:sdab-358": "remotion render video/src/index.ts CC18Vertical video/out/sdab-358.mp4 --props=video/examples/sdab-358.json --codec=h264 --crf=18 --pixel-format=yuv420p",
    "video:d1:process-one": "node scripts/video/process-d1-one.mjs",
    "video:props": "node scripts/video/build-props.mjs",
    "video:props:test": "node --test tests/video-props.test.mjs",
    "publisher:test": "node --test tests/publisher.test.mjs",
    "publish:d1:process-one": "node scripts/publish/process-d1-one.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "latest",
    "@remotion/cli": "latest",
    "@remotion/transitions": "latest",
    "astro": "latest",
    "aws4fetch": "1.0.20",
    "cheerio": "latest",
    "ffmpeg-static": "latest",
    "playwright-core": "latest",
    "react": "latest",
    "react-dom": "latest",
    "remotion": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "wrangler": "^4.125.0"
  }
}
