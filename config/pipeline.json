{
  "source": {
    "name": "cc18.tv",
    "base_url": "https://cc18.tv/",
    "allowed_hosts": ["cc18.tv", "www.cc18.tv"],
    "user_agent": "CC18ReviewBot/0.3 (+https://github.com/yaoshengmarketing-prog/cc18)",
    "date_source": "work_page_field",
    "cover_policy": "download_to_r2"
  },
  "discovery": {
    "listing_urls": ["https://cc18.tv/"],
    "lookback_days": 7,
    "scan_window_days": 14,
    "upcoming_window_days": 30,
    "ingest_all_eligible": true,
    "minimum_candidates": 1,
    "request_delay_ms": 1000,
    "maximum_error_ratio": 0.2
  },
  "queue": {
    "authority": "cloudflare_d1",
    "database_name": "cc18-db",
    "local_snapshot": "data/pipeline-queue.json",
    "initial_stage": "editorial",
    "initial_stages": ["editorial", "media_analysis"],
    "lease_seconds": 900,
    "max_attempts": 5
  },
  "production": {"mode": "scheduled_serial", "discovery_executor": "github_actions", "drain_executor": "github_actions", "drain_interval_minutes": 60, "drain_time_budget_minutes": 50, "batch_size": 1, "max_parallel": 1, "continue_on_media_failure": true},
  "canary": {"enabled": true, "default_batch_size": 1, "max_per_run": 3, "require_validated_metadata": true, "media_analysis": "optional_non_blocking", "stages": ["editorial", "image", "video", "publish"]},
  "editorial": {
    "writer_contract": "prompts/review-writer.md",
    "critic_contract": "prompts/review-critic.md",
    "review_policy": "config/review-policy.json",
    "scorecard": "config/review-scorecard.json",
    "title_policy": "config/title-policy.json",
    "publish_only_after_quality_gate": true
  },
  "media": {"r2_prefix": "works/{yyyy}/{mm}/{id}", "video_duration_seconds": 9, "vertical": "1080x1920", "hero": "1600x900"},
  "source_media_analysis": {
    "enabled": true,
    "mode": "local_browser_bridge",
    "publish_review_without_analysis": true,
    "allow_source_grounded_editorial": true,
    "allow_metadata_only_as_review": false,
    "deep_analysis_mode": "optional_selected_works",
    "evidence_schema_version": 1
  },
  "publishing": {
    "daily_enabled": false,
    "source_cta_required": true,
    "base_url": "https://cc18.pages.dev",
    "cloudflare_pages_project": "cc18",
    "deployment_timeout_seconds": 600,
    "deployment_poll_seconds": 10
  }
}
