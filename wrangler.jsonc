{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cc18",
  "compatibility_date": "2026-08-25",
  "pages_build_output_dir": "./dist",
  "vars": {
    "SITE_URL": "https://jav.com.tw",
    "MEDIA_BASE_URL": "https://cc18.pages.dev/media"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cc18-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cc18-db",
      "database_id": "22a227d0-e7be-4bd0-8e6b-043ab49ead4c",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
