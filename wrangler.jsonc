{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cc18",
  "compatibility_date": "2026-08-25",
  "pages_build_output_dir": "./dist",
  "vars": {
    "SITE_URL": "https://cc18.pages.dev",
    "MEDIA_BASE_URL": "https://cc18.pages.dev/media"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cc18-media"
    }
  ]
}
