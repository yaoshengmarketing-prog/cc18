---
import '../styles/global.css';
import {SITE_NAME, formatPageTitle} from '../lib/site-brand.mjs';

interface Props {
  title: string;
  socialTitle?: string;
  description?: string;
  image?: string;
  robots?: string;
  adult?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  video?: string;
  releaseId?: string;
  brandFirst?: boolean;
}

const {
  title,
  socialTitle = title,
  description = '整理 CC18 最新作品、演員、系列、題材標籤與原創影評，快速找到想看的作品。',
  image = '/images/demo-hero.svg',
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  adult = false,
  structuredData,
  video,
  releaseId,
  brandFirst = false,
} = Astro.props;
const pageTitle = formatPageTitle(title, {brandFirst});
const socialPageTitle = formatPageTitle(socialTitle, {brandFirst});
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const jsonLd = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : null;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    {import.meta.env.PROD && <script is:inline>
      if (window.location.hostname === 'jav.com.tw') {
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-0FG819HD2T');
        const tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-0FG819HD2T';
        document.head.appendChild(tag);
      }
    </script>}
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {releaseId && <meta name="cc18-release-id" content={releaseId} />}
    {adult && <meta name="rating" content="adult" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={socialPageTitle} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url.origin)} />
    {video && <meta property="og:video" content={new URL(video, Astro.site ?? Astro.url.origin)} />}
    {video && <meta property="og:video:type" content="video/mp4" />}
    <meta name="theme-color" content="#101b25" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳至主要內容</a>
    <header class="site-header">
      <div class="header-main">
        <a class="brand" href="/" aria-label={`${SITE_NAME}首頁`}>
          <span class="brand-mark">JAV</span>
          <span class="brand-name">{SITE_NAME}<small>新片情報與選片指南</small></span>
        </a>
        <nav aria-label="主要導覽">
          <a href="/latest/">最新作品</a>
          <a href="/actresses/">演員</a>
          <a href="/series/">系列</a>
          <a href="/tags/">題材</a>
        </nav>
        <div class="header-actions">
          <a class="search-link" href="/search/" aria-label="搜尋作品">⌕ <span>搜尋</span></a>
          <a class="source-pill" href="https://cc18.tv/" target="_blank" rel="sponsored noopener">前往 CC18 ↗</a>
        </div>
      </div>
      <nav class="topic-nav" aria-label="快速分類">
        <a href="/latest/">新片</a>
        <a href="/tags/married-woman/">人妻</a>
        <a href="/tags/office-lady/">OL</a>
        <a href="/tags/amateur/">素人</a>
        <a href="/tags/story/">劇情</a>
        <a href="/tags/self-shot/">自拍視角</a>
        <a href="/tags/group-sex/">多人企劃</a>
        <a href="/tags/uhd-4k/">4K</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div>
        <span class="brand-mark small">JAV</span>
        <strong>{SITE_NAME}</strong>
        <p>整理 CC18 作品資料、題材線索與選片觀點；完整內容請前往原始作品頁。</p>
      </div>
      <nav aria-label="頁尾導覽">
        <a href="/method/">編輯與分析方法</a>
        <a href="https://cc18.tv/" target="_blank" rel="sponsored noopener">CC18 官方作品站 ↗</a>
      </nav>
    </footer>
  </body>
</html>
