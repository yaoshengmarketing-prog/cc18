---
import {sourceTagGroupLabels, sourceTagItems, topicElementsFromSourceTags} from '../lib/taxonomy';

const {sourceTags, sourceTagRelations = []} = Astro.props;
const elements = topicElementsFromSourceTags(sourceTags);
const items = sourceTagItems(sourceTags, sourceTagRelations);
const itemsByLabel = new Map(items.map((item) => [item.label, item]));
const rows: Array<{group: string; label: string; values: string[]}> = [...sourceTagGroupLabels].flatMap(([group, label]) => {
  const values = elements[group] ?? [];
  return values.length ? [{group, label, values}] : [];
});
const otherSourceTags = items.filter((item) => !item.id).map((item) => item.label);
if (otherSourceTags.length) rows.push({group: 'other', label: '其他來源標籤', values: otherSourceTags});
---
{rows.length > 0 && (
  <section class="topic-elements" aria-labelledby="topic-elements-title">
    <div class="topic-elements-heading">
      <div><p class="eyebrow">SOURCE TOPIC MAP</p><h2 id="topic-elements-title">這部作品有哪些題材元素？</h2></div>
      <p>依 CC18 原始標籤整理，讓人物、身材、關係、場景、行為與呈現方式可以快速比較。</p>
    </div>
    <dl class="topic-elements-grid">
      {rows.map(({group, label, values}) => (
        <div data-group={group}>
          <dt>{label}</dt>
          <dd>{values.map((value) => {
            const item = itemsByLabel.get(value);
            return item?.href
              ? <a href={item.href}>{value}</a>
              : <span>{value}</span>;
          })}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
