---
interface Props {src?: string; poster: string; sourceUrl: string; title: string;}
const {src, poster, sourceUrl, title} = Astro.props;
---
<section class="video-shell" aria-label={`${title} 短影音`}>
  {src ? (
    <video controls playsinline preload="metadata" poster={poster}>
      <source src={src} type="video/mp4" />
      瀏覽器不支援 HTML5 影片。
    </video>
  ) : (
    <div class="video-pending" style={`--poster:url('${poster}')`}>
      <span>VIDEO PREVIEW</span>
      <strong>短影音製作中</strong>
      <p>作品資料與影評已可閱讀，短影音完成後會在這裡更新。</p>
      <a href={sourceUrl} target="_blank" rel="sponsored noopener">先到 CC18 查看作品 ↗</a>
    </div>
  )}
</section>
