---
import type {Review} from '../lib/reviews';
import {reviewHref} from '../lib/reviews';
import type {SearchContent} from '../lib/search-content';
import {decisionLevelLabel, paceLabel} from '../lib/search-content';
import {decisionGuideViewModel} from '../lib/decision-guide.mjs';

interface TimelineItem {
  phase: 'opening' | 'middle' | 'late';
  label: string;
  summary: string;
  evidence_windows: number[];
}
interface Props {content: SearchContent; related: Map<string, Review>; timeline?: TimelineItem[];}
const {content, related, timeline = []} = Astro.props;
const phaseLabel = {opening: '開端', middle: '中段', late: '後段'};
const view = decisionGuideViewModel(content, timeline);
const {quickDecision, thesis, presentation, audienceFor, audienceNotFor, recommendations, hasMetrics, hasContent} = view;
---

{hasContent && <section class="decision-guide" aria-labelledby="decision-title">
  <header class="decision-heading">
    <div>
      <p class="eyebrow">WATCH DECISION BOARD</p>
      <h2 id="decision-title">先判斷這部適不適合你</h2>
    </div>
  </header>

  <div class="decision-summary">
    {thesis && <p class="decision-thesis">{thesis}</p>}
    {hasMetrics && <dl class="decision-metrics">
      {quickDecision?.story_density && <div><dt>故事密度</dt><dd>{decisionLevelLabel(quickDecision.story_density)}</dd></div>}
      {quickDecision?.pace && <div><dt>節奏傾向</dt><dd>{paceLabel(quickDecision.pace)}</dd></div>}
      {presentation.length > 0 && <div><dt>呈現方式</dt><dd>{presentation.join(' · ')}</dd></div>}
    </dl>}
  </div>

  {view.timeline.length > 0 && (
    <div class="timeline-board" aria-label="分散抽樣結構摘要">
      {view.timeline.map((item: TimelineItem) => (
        <article class={`timeline-stop ${item.phase}`}>
          <div class="timeline-index"><span>{phaseLabel[item.phase]}</span><b>{item.label}</b></div>
          <p>{item.summary}</p>
          <small>抽樣窗 {item.evidence_windows.map((index) => index + 1).join('、')}</small>
        </article>
      ))}
    </div>
  )}

  {(audienceFor.length > 0 || audienceNotFor.length > 0) && <div class="fit-grid">
    {audienceFor.length > 0 && <section>
      <h3>比較適合</h3>
      <ul>{audienceFor.map((item) => <li>{item}</li>)}</ul>
    </section>}
    {audienceNotFor.length > 0 && <section class="not-for">
      <h3>可能不適合</h3>
      <ul>{audienceNotFor.map((item) => <li>{item}</li>)}</ul>
    </section>}
  </div>}

  {recommendations.length > 0 && (
    <section class="reasoned-recommendations">
      <div class="mini-heading"><p class="eyebrow">WHY THIS NEXT</p><h3>有理由的延伸選片</h3></div>
      <div class="recommendation-list">
        {recommendations.map((item) => {
          const review = related.get(item.movie_id);
          return review && (
            <a href={reviewHref(review)}>
              <span class="mono-value">{item.movie_id}</span>
              <b>{review.data.displayShortTitle ?? review.data.title}</b>
              <p>{item.reason}</p>
              <small>共同：{item.shared_signals.join('、')}　／　差異：{item.contrast_signals.join('、')}</small>
            </a>
          );
        })}
      </div>
    </section>
  )}
</section>}
