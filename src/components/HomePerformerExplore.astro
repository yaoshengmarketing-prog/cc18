---
interface Props {
  count: number;
}

const {count} = Astro.props;
if (!Number.isInteger(count) || count < 1) {
  throw new Error('Homepage performer exploration requires a positive integer count');
}
---

<section
  class="home-performer-explore"
  aria-labelledby="home-performer-explore-title"
  data-home-performer-explore
>
  <div>
    <p class="eyebrow">EXPLORE PERFORMERS</p>
    <h2 id="home-performer-explore-title">從演員找作品</h2>
    <p>依演員姓名瀏覽本站收錄的人物與已發布作品。目前收錄 {count} 位人物。</p>
  </div>
  <a href="/actresses/">查看全部演員 →</a>
</section>

<style>
  .home-performer-explore {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    margin-bottom: 100px;
    padding: clamp(24px, 4vw, 38px);
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--line);
  }
  .home-performer-explore div { min-width: 0; }
  .home-performer-explore h2 { margin: 4px 0 10px; }
  .home-performer-explore div > p:last-child { max-width: 650px; margin: 0; color: var(--slate); }
  .home-performer-explore a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 11px 18px;
    color: #fff;
    background: #d71161;
    font-weight: 800;
    text-decoration: none;
  }
  .home-performer-explore a:hover { background: var(--apricot-dark); }
  .home-performer-explore a:focus-visible { outline: 3px solid var(--apricot-dark); outline-offset: 3px; }
  @media (max-width: 700px) {
    .home-performer-explore { grid-template-columns: 1fr; gap: 20px; margin-bottom: 72px; }
    .home-performer-explore a { justify-self: start; }
  }
</style>
