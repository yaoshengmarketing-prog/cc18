---
import {getCollection, render} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import {formatDate, visibleTags} from '../../lib/reviews';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews', ({data}) => data.status === 'published');
  return reviews.map((review) => ({params: {id: review.data.id.toLowerCase()}, props: {review}}));
}
const {review} = Astro.props;
const {Content} = await render(review);
---
<BaseLayout title={`${review.data.id} ${review.data.title}`} description={review.data.shortReview} image={review.data.heroUrl ?? review.data.coverUrl}>
  <article class="review-page">
    <header class="review-header">
      <div class="review-cover"><img src={review.data.coverUrl} alt={`${review.data.id} 作品封面`} /></div>
      <div class="review-heading">
        <p class="eyebrow">ORIGINAL REVIEW · 公開資料評論</p>
        <p class="hero-number">{review.data.id}</p>
        <h1>{review.data.title}</h1>
        <p class="lead">{review.data.shortReview}</p>
        <dl class="metadata">
          <div><dt>演員</dt><dd>{review.data.actress.join('、') || '待補'}</dd></div>
          <div><dt>上片日期</dt><dd>{formatDate(review.data.releaseDate)}</dd></div>
          <div><dt>系列</dt><dd>{review.data.series ?? '—'}</dd></div>
          <div><dt>影評切角</dt><dd>{review.data.editorialAngle}</dd></div>
        </dl>
        <TagList tags={visibleTags(review)} />
        <a class="button source-cta" href={review.data.sourceUrl} target="_blank" rel="sponsored noopener">
          <span>在 CC18 查看完整作品資訊</span><b>前往原始作品頁 ↗</b>
        </a>
      </div>
    </header>
    <VideoPlayer src={review.data.videoUrl} poster={review.data.heroUrl ?? review.data.coverUrl} sourceUrl={review.data.sourceUrl} title={review.data.id} />
    <div class="article-layout">
      <div class="article-body"><Content /></div>
      <aside>
        <p class="eyebrow">SOURCE</p>
        <h2>作品來源</h2>
        <p>番號、演員、日期、系列、標籤與公開簡介取自 CC18 作品頁。本文為依公開資訊重新撰寫的原創介紹。</p>
        <a href={review.data.sourceUrl} target="_blank" rel="sponsored noopener">開啟 CC18 原始頁面 ↗</a>
      </aside>
    </div>
  </article>
</BaseLayout>
