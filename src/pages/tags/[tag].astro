---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import {byNewest} from '../../lib/reviews';
export async function getStaticPaths() {
  const reviews = await getCollection('reviews', ({data}) => data.status === 'published');
  const tags = [...new Set(reviews.flatMap((r) => [...r.data.canonicalTags, ...r.data.discoveryTags]))];
  return tags.map((tag) => ({params: {tag}, props: {tag, reviews: reviews.filter((r) => [...r.data.canonicalTags, ...r.data.discoveryTags].includes(tag)).sort(byNewest)}}));
}
const {tag, reviews} = Astro.props;
---
<BaseLayout title={`#${tag}`}><section class="page-intro"><p class="eyebrow">TAG COLLECTION</p><h1>#{tag}</h1><p>以統一標籤聚合的作品與原創影評。</p></section><section class="card-grid">{reviews.map((review) => <ReviewCard review={review} />)}</section></BaseLayout>
