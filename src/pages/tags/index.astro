---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {taxonomyTag} from '../../lib/taxonomy';
import {reviewTagIds} from '../../lib/reviews';
const reviews = await getCollection('reviews', ({data}) => data.status === 'published');
const counts = new Map<string, number>();
reviews.flatMap(reviewTagIds).forEach((id) => counts.set(id, (counts.get(id) ?? 0) + 1));
---
<BaseLayout title="標籤索引"><section class="page-intro"><p class="eyebrow">TAG TAXONOMY</p><h1>標籤索引</h1><p>來源詞會完整保留；站內聚合只使用經過定義與映射的穩定標籤。</p></section><section class="tag-cloud">{[...counts].map(([id,count]) => { const tag = taxonomyTag(id); return tag && <a href={`/tags/${id}/`}><strong>#{tag.label}</strong><span>{count}</span></a>; })}</section></BaseLayout>
