---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="站內搜尋" description="以番號、作品名稱、演員繁中名、日文原名與正式題材搜尋 CC18 已發布作品。" robots="noindex,follow" adult={true}>
  <section class="search-page" data-catalog-search-v1>
    <header class="page-intro search-intro">
      <p class="eyebrow">CATALOG SEARCH</p>
      <h1>從一段名字，找到同一部作品</h1>
      <p>輸入番號、片名、演員日文名或繁中別名。中文或日文人物名稱可從一個字開始搜尋，其他查詢請輸入至少兩個字元。</p>
    </header>
    <form class="catalog-search" action="/search/" method="get" role="search">
      <label for="catalog-query">搜尋人物可輸入一個中文或日文字；番號、片名與題材請輸入至少兩個字元</label>
      <div>
        <input id="catalog-query" name="q" type="search" autocomplete="off" enterkeyhint="search" placeholder="番號、片名、演員或題材" />
        <button type="submit">搜尋</button>
      </div>
    </form>
    <p id="search-status" class="search-status" aria-live="polite">正在載入作品索引…</p>
    <div id="search-results" class="catalog-search-results" hidden>
      <section id="people-section" class="search-result-group" aria-labelledby="people-heading" hidden>
        <header><p class="eyebrow">PEOPLE</p><h2 id="people-heading">符合的人物 <span id="people-count"></span></h2></header>
        <div id="people-results" class="people-results"></div>
      </section>
      <section id="movies-section" class="search-result-group" aria-labelledby="movies-heading" hidden>
        <header><p class="eyebrow">MOVIES</p><h2 id="movies-heading">符合的作品 <span id="movies-count"></span></h2></header>
        <div id="movie-results" class="movie-search-results"></div>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import {searchCatalog} from '../../lib/catalog-search.mjs';
  import {performerHref} from '../../lib/performer-url.mjs';

  const form = document.querySelector<HTMLFormElement>('.catalog-search');
  const input = document.querySelector<HTMLInputElement>('#catalog-query');
  const status = document.querySelector<HTMLElement>('#search-status');
  const results = document.querySelector<HTMLElement>('#search-results');
  const peopleSection = document.querySelector<HTMLElement>('#people-section');
  const peopleResults = document.querySelector<HTMLElement>('#people-results');
  const peopleCount = document.querySelector<HTMLElement>('#people-count');
  const moviesSection = document.querySelector<HTMLElement>('#movies-section');
  const movieResults = document.querySelector<HTMLElement>('#movie-results');
  const moviesCount = document.querySelector<HTMLElement>('#movies-count');
  let index: any = null;

  const text = (tag: string, className: string | null, value: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    node.textContent = value;
    return node;
  };

  const renderPerson = (person: any) => {
    const article = document.createElement('article');
    article.className = 'person-search-result';
    article.dataset.actorId = person.stable_actor_id;
    const identity = document.createElement('div');
    identity.className = 'person-search-result__identity';
    const profileLink = document.createElement('a');
    profileLink.href = performerHref(person.stable_actor_id);
    profileLink.append(text('h3', null, person.display_name));
    identity.append(profileLink, text('p', 'search-match-reason', `命中名稱：${person.match_name}`));
    const alternateNames = [...new Set([person.name_ja, person.source_name].filter((name) => name && name !== person.display_name))];
    if (alternateNames.length) identity.append(text('p', 'person-search-result__alternate', `原名／來源名：${alternateNames.join('、')}`));
    const works = document.createElement('div');
    works.className = 'person-search-result__works';
    works.append(text('p', null, '相關已發布作品'));
    for (const movieId of person.related_movie_ids) {
      const movie = index.movies.find(({card}: any) => card.stable_movie_id === movieId);
      if (!movie) continue;
      const link = document.createElement('a');
      link.href = movie.card.href;
      link.textContent = movie.card.catalog_code;
      works.append(link);
    }
    article.append(identity, works);
    return article;
  };

  const renderMovie = (movie: any) => {
    const article = document.createElement('article');
    article.className = 'movie-search-result';
    article.dataset.movieId = movie.card.stable_movie_id;
    const coverLink = document.createElement('a');
    coverLink.className = 'movie-search-result__cover';
    coverLink.href = movie.card.href;
    coverLink.setAttribute('aria-label', `閱讀 ${movie.card.catalog_code} 影評`);
    const image = document.createElement('img');
    image.src = movie.card.source_cover;
    image.alt = `${movie.card.catalog_code} 作品封面`;
    image.loading = 'lazy';
    image.dataset.coverFallback = '/images/movie-cover-fallback.svg';
    coverLink.append(image);
    const copy = document.createElement('div');
    copy.className = 'movie-search-result__copy';
    const meta = document.createElement('div');
    meta.className = 'movie-search-result__meta';
    meta.append(text('span', 'mono-value', movie.card.catalog_code));
    if (movie.card.release_date) meta.append(text('time', null, movie.card.release_date));
    const titleLink = document.createElement('a');
    titleLink.href = movie.card.href;
    titleLink.append(text('h3', null, movie.card.title));
    copy.append(meta, titleLink, text('p', 'search-match-reason', movie.match_reason));
    if (movie.card.performers.length) copy.append(text('p', 'movie-search-result__performers', movie.card.performers.join('、')));
    if (movie.card.canonical_topics.length) {
      const topics = document.createElement('ul');
      topics.className = 'movie-search-result__topics';
      topics.setAttribute('aria-label', '作品題材');
      for (const topic of movie.card.canonical_topics.slice(0, 3)) topics.append(text('li', null, topic.label));
      copy.append(topics);
    }
    article.append(coverLink, copy);
    return article;
  };

  const render = (query: string) => {
    if (!index || !results || !status || !peopleSection || !peopleResults || !peopleCount || !moviesSection || !movieResults || !moviesCount) return;
    const found = searchCatalog(index, query);
    peopleResults.replaceChildren();
    movieResults.replaceChildren();
    peopleSection.hidden = true;
    moviesSection.hidden = true;
    results.hidden = true;
    if (found.reason === 'empty') {
      status.textContent = `可搜尋 ${index.counts.movies} 部已發布作品與 ${index.counts.performers} 位演員。`;
      return;
    }
    if (found.reason === 'too_short') {
      status.textContent = '人物姓名可輸入一個中文或日文字；英文、數字及其他查詢請至少輸入兩個字元。';
      return;
    }
    status.textContent = found.people.length || found.movies.length
      ? `找到 ${found.people.length} 位人物、${found.movies.length} 部作品。`
      : `找不到「${found.query}」；可改用完整番號、演員姓名或兩字以上片段。`;
    if (!found.people.length && !found.movies.length) return;
    results.hidden = false;
    if (found.people.length) {
      peopleSection.hidden = false;
      peopleCount.textContent = String(found.people.length);
      peopleResults.append(...found.people.map(renderPerson));
    }
    if (found.movies.length) {
      moviesSection.hidden = false;
      moviesCount.textContent = String(found.movies.length);
      movieResults.append(...found.movies.map(renderMovie));
    }
  };

  movieResults?.addEventListener('error', (event) => {
    const image = event.target;
    if (!(image instanceof HTMLImageElement) || image.dataset.fallbackApplied === 'true') return;
    image.dataset.fallbackApplied = 'true';
    image.src = image.dataset.coverFallback ?? '/images/movie-cover-fallback.svg';
  }, true);

  const queryFromUrl = () => new URLSearchParams(location.search).get('q') ?? '';
  fetch('/search-index.json').then((response) => {
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json();
  }).then((payload) => {
    index = payload;
    const query = queryFromUrl();
    if (input) input.value = query;
    render(query);
  }).catch(() => { if (status) status.textContent = '作品索引暫時無法載入，請稍後再試。'; });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input?.value.trim() ?? '';
    history.pushState(null, '', query ? `/search/?q=${encodeURIComponent(query)}` : '/search/');
    render(query);
  });
  addEventListener('popstate', () => {
    const query = queryFromUrl();
    if (input) input.value = query;
    render(query);
  });
</script>
