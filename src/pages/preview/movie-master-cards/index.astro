---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MovieCardV1 from '../../../components/MovieCardV1.astro';
import {loadMovieMasterCardPreview} from '../../../lib/movie-master.mjs';

const preview = await loadMovieMasterCardPreview();
const expectedExclusionCount = preview.index.formal_draft_count + preview.index.demo_count;
if (preview.cards.length !== preview.index.published_count) {
  throw new Error(`Movie Master card preview expected ${preview.index.published_count} published cards, received ${preview.cards.length}`);
}
if (preview.exclusions.length !== expectedExclusionCount || preview.exclusions.some(({is_published}) => is_published)) {
  throw new Error(`Movie Master card preview expected ${expectedExclusionCount} draft/demo exclusions without published works, received ${preview.exclusions.length}`);
}
---

<BaseLayout
  title="Movie Master 基本作品卡預覽"
  description="以 Movie Master v1 驗證基本作品卡的資料完整度、資訊層級與響應式呈現。"
  robots="noindex,nofollow"
  adult={true}
>
  <section class="master-preview-intro">
    <p class="eyebrow">MOVIE MASTER V1 / PRIVATE PREVIEW</p>
    <div>
      <h1>用同一套資料，<br />把選片資訊排清楚。</h1>
      <p>本頁只顯示通過基本卡資格的已發布作品。資料直接取自 Movie Master；缺值隱藏，不以推測文字補版面。</p>
    </div>
    <dl aria-label="預覽資料摘要">
      <div><dt>已發布卡片</dt><dd>{preview.cards.length}</dd></div>
      <div><dt>正式草稿排除</dt><dd>{preview.index.formal_draft_count}</dd></div>
      <div><dt>Demo 排除</dt><dd>{preview.index.demo_count}</dd></div>
    </dl>
  </section>

  <section class="master-preview-grid" aria-label="Movie Master 基本作品卡">
    {preview.cards.map((card, index) => <MovieCardV1 card={card} priority={index < 3} />)}
  </section>
</BaseLayout>

<style>
  .master-preview-intro,
  .master-preview-grid { width: var(--content); margin-inline: auto; }
  .master-preview-intro {
    margin-top: 42px;
    padding: clamp(28px, 4vw, 56px);
    color: #fff;
    background: #151619;
    border-top: 6px solid #ff4d98;
  }
  .master-preview-intro > div {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, .65fr);
    align-items: end;
    gap: clamp(30px, 6vw, 90px);
  }
  .master-preview-intro h1 {
    margin: 0;
    font: 900 clamp(36px, 5vw, 68px)/1.15 var(--display);
    letter-spacing: -.04em;
  }
  .master-preview-intro > div > p {
    margin: 0 0 6px;
    color: rgba(255, 255, 255, .66);
    font-size: 14px;
  }
  .master-preview-intro dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 34px 0 0;
    border-top: 1px solid rgba(255, 255, 255, .18);
  }
  .master-preview-intro dl div { padding: 16px 12px 0 0; }
  .master-preview-intro dt { color: rgba(255, 255, 255, .48); font: 500 10px/1.4 var(--utility); }
  .master-preview-intro dd { margin: 7px 0 0; color: #ff78ae; font: 700 25px/1 var(--utility); }
  .master-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 18px;
    margin-block: 24px 100px;
  }
  @media (max-width: 900px) {
    .master-preview-intro > div { grid-template-columns: 1fr; gap: 18px; }
    .master-preview-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .master-preview-intro { margin-top: 18px; padding: 24px 20px; }
    .master-preview-intro h1 br { display: none; }
    .master-preview-intro dl { grid-template-columns: 1fr; }
    .master-preview-intro dl div { display: flex; justify-content: space-between; align-items: baseline; padding: 11px 0; border-bottom: 1px solid rgba(255, 255, 255, .12); }
    .master-preview-intro dd { font-size: 18px; }
    .master-preview-grid { grid-template-columns: 1fr; gap: 18px; margin-block: 18px 70px; }
  }
</style>
