---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MovieCardV1 from '../../components/MovieCardV1.astro';
import {loadAggregateCatalog} from '../../lib/aggregate-catalog.mjs';

interface Card {catalog_code: string; href: string; release_date: string; title: string; source_cover: string; performers: string[]; canonical_topics: Array<{id: string; label: string}>; has_remotion_promo: boolean; stable_movie_id: string;}
interface Group {type: 'prefixes' | 'studios' | 'months'; key: string; href: string; label: string; summary: string; index_decision: string; public_work_count: number; public_works: Card[];}
const labels = {prefixes: '番號前綴', studios: '片商', months: '發行月份'};
export async function getStaticPaths() {
  const catalog = await loadAggregateCatalog();
  return (['prefixes', 'studios', 'months'] as const).flatMap((type) => catalog[type].map((group: Group) => ({
    params: {aggregate: type, id: encodeURIComponent(group.key.toLowerCase())},
    props: {group},
  })));
}
const {group} = Astro.props as {group: Group};
const label = labels[group.type];
const canonical = new URL(group.href, Astro.site ?? Astro.url.origin).href;
const structuredData = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      {'@type': 'ListItem', position: 1, name: '首頁', item: new URL('/', canonical).href},
      {'@type': 'ListItem', position: 2, name: label, item: new URL(`/${group.type}/`, canonical).href},
      {'@type': 'ListItem', position: 3, name: group.label, item: canonical},
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', url: canonical, name: group.label,
    description: group.summary,
    mainEntity: {
      '@type': 'ItemList', numberOfItems: group.public_work_count,
      itemListElement: group.public_works.map((card, index) => ({
        '@type': 'ListItem', position: index + 1, name: card.catalog_code,
        item: new URL(card.href, canonical).href,
      })),
    },
  },
];
---
<BaseLayout title={`${group.label}作品整理`} description={group.summary} robots={group.index_decision === 'INDEX_READY' ? undefined : 'noindex,follow'} adult={true} structuredData={structuredData}>
  <article class="aggregate-page">
    <nav class="breadcrumbs" aria-label="麵包屑"><a href="/">首頁</a><span>／</span><a href={`/${group.type}/`}>{label}</a><span>／</span><b>{group.label}</b></nav>
    <header class="page-intro"><p class="eyebrow">PUBLISHED WORKS</p><h1>{group.label}</h1><p>{group.summary}</p><p>依發行日新到舊排列，範圍僅含本站已發布作品。</p></header>
    <div class="card-grid movie-card-grid">{group.public_works.map((card) => <MovieCardV1 card={card} />)}</div>
  </article>
</BaseLayout>
