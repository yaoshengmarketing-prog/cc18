---
import {getCollection, render} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import WorkFacts from '../../components/WorkFacts.astro';
import EvidenceNotice from '../../components/EvidenceNotice.astro';
import DecisionGuide from '../../components/DecisionGuide.astro';
import TopicElements from '../../components/TopicElements.astro';
import {reviewEditorialTags, visibleTags} from '../../lib/reviews';
import {sourceTagItems} from '../../lib/taxonomy';
import {sourceRecordFor} from '../../lib/source-records';
import {searchContentFor} from '../../lib/search-content';
import {reviewQualityFor} from '../../lib/review-quality';
import {loadPerformerCatalog} from '../../lib/performer-catalog.mjs';
import {loadSeriesCatalog} from '../../lib/series-catalog.mjs';
import {loadPublishedWorkEvidenceCatalog} from '../../lib/movie-master.mjs';
import {SITE_NAME} from '../../lib/site-brand.mjs';

interface OrderedPerformerRecord {
  stable_performer_id: string;
  primary_display_name: string;
  href: string;
}
interface OrderedSeriesRecord {
  stable_series_id: string;
  source_name: string;
  display_name: string;
  href: string;
}

export async function getStaticPaths() {
  const [reviews, performerCatalog, seriesCatalog, evidenceCatalog] = await Promise.all([
    getCollection('reviews', ({data}) => data.status === 'published'),
    loadPerformerCatalog(),
    loadSeriesCatalog(),
    loadPublishedWorkEvidenceCatalog(),
  ]);
  return reviews.map((review) => ({
    params: {id: review.data.id.toLowerCase()},
    props: {
      review,
      performers: (performerCatalog.ordered_performers_by_work as Array<{
        stable_movie_id: string;
        performers: OrderedPerformerRecord[];
      }>).find(({stable_movie_id: stableMovieId}) => stableMovieId === `cc18:${review.data.id}`)?.performers ?? [],
      series: (seriesCatalog.ordered_series_by_work as Array<{
        stable_movie_id: string;
        series: OrderedSeriesRecord[];
      }>).find(({stable_movie_id: stableMovieId}) => stableMovieId === `cc18:${review.data.id}`)?.series ?? [],
      evidence: evidenceCatalog.records.find(({stable_movie_id: stableMovieId}) => stableMovieId === `cc18:${review.data.id}`),
    },
  }));
}
const {review, performers, series, evidence} = Astro.props;
const {Content} = await render(review);
const allReviews = await getCollection('reviews', ({data}) => data.status === 'published');
const related = new Map(allReviews.map((item) => [item.data.id, item]));
const source = sourceRecordFor(review.data.id);
const search = searchContentFor(review.data.id);
const quality = reviewQualityFor(review.data.id);
const editorialTags = reviewEditorialTags(review);
const canonicalTags = visibleTags(review);
const rawSourceTags = sourceTagItems(review.data.sourceTags, source?.source_relations?.tags);
const hasPerformerNames = performers.length > 0 || review.data.actress.length > 0;
if (!quality?.approved_for_publish) throw new Error(`${review.data.id}: approved review quality record missing`);
if (!evidence) throw new Error(`${review.data.id}: Movie Master Evidence projection missing`);
// The existing Evidence projection describes the material used, not editorial depth.
const articleLabel = evidence.evidence_level === 'DISTRIBUTED_SAMPLE' ? '影片抽樣分析' : '來源資料整理';
// Approved Markdown owns the work H1, article H2, lead and body. Source Record
// keeps the original source name and URL; Movie Master projects card titles.
const lead = review.data.shortReview;
const sourceTitleIsReadableZh = /[\u3400-\u9fff]/u.test(review.data.sourceTitle)
  && !/[\u3041-\u3096\u30a1-\u30fa]/u.test(review.data.sourceTitle)
  && review.data.sourceTitle.length <= 36;
const heading = review.data.workTitle ?? review.data.displayShortTitle
  ?? (sourceTitleIsReadableZh ? review.data.sourceTitle : review.data.title.replace(new RegExp(`^${review.data.id}\\s*[｜|:：-]?\\s*`, 'i'), '').trim());
const titleSubject = review.data.seoTitle;
const socialTitleSubject = review.data.socialTitle;
const showSourceName = review.data.sourceTitle !== heading;
const hasPublishedVideo = review.data.videoStatus === 'rendered' && Boolean(review.data.videoUrl);
const sourceLinkLabel = `CC18：${review.data.id}《${review.data.sourceTitle}》`;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageUrl = new URL(review.data.heroUrl ?? review.data.coverUrl, Astro.site ?? Astro.url.origin);
const structuredData: Array<Record<string, unknown>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {'@type': 'ListItem', position: 1, name: '首頁', item: new URL('/', pageUrl).href},
      {'@type': 'ListItem', position: 2, name: '作品影評', item: new URL('/latest/', pageUrl).href},
      {'@type': 'ListItem', position: 3, name: review.data.id, item: pageUrl.href},
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: review.data.title,
    description: lead,
    image: imageUrl.href,
    datePublished: review.data.publishedAt.toISOString(),
    dateModified: source?.fetched_at ?? review.data.publishedAt.toISOString(),
    inLanguage: 'zh-Hant',
    mainEntityOfPage: pageUrl.href,
    publisher: {'@type': 'Organization', name: SITE_NAME},
    about: [
      review.data.id,
      ...review.data.actress,
      ...series.map((item: OrderedSeriesRecord) => ({
        '@type': 'Thing',
        name: item.display_name,
        url: new URL(item.href, pageUrl).href,
      })),
    ],
  },
];
if (hasPublishedVideo && review.data.videoUrl) structuredData.push({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: review.data.socialTitle,
  description: lead,
  thumbnailUrl: [imageUrl.href],
  uploadDate: review.data.publishedAt.toISOString(),
  duration: 'PT9S',
  contentUrl: new URL(review.data.videoUrl, pageUrl).href,
  embedUrl: pageUrl.href,
  isFamilyFriendly: false,
});
---
<BaseLayout title={titleSubject} socialTitle={socialTitleSubject} description={lead} image={review.data.heroUrl ?? review.data.coverUrl} video={hasPublishedVideo ? review.data.videoUrl : undefined} releaseId={quality.review_sha256} adult={true} structuredData={structuredData}>
  <article class="review-page">
    <nav class="breadcrumbs" aria-label="麵包屑">
      <a href="/">首頁</a><span>／</span><a href="/latest/">作品影評</a><span>／</span><b>{review.data.id}</b>
    </nav>
    <header class="work-page-hero">
      <div class="work-hero-copy">
        <p class="work-identity"><span class="mono-value">{review.data.id}</span><span class="work-material-label">{articleLabel}</span></p>
        <h1>{heading}</h1>
        {review.data.originalTitleJa && <p class="work-name-line"><span>日文原題</span><b lang="ja">{review.data.originalTitleJa}</b></p>}
        {review.data.translatedTitleZhTw && review.data.translatedTitleZhTw !== heading && <p class="work-name-line"><span>繁中直譯</span><b>{review.data.translatedTitleZhTw}</b></p>}
        {showSourceName && <p class="work-name-line"><span>來源名稱</span><b>{review.data.sourceTitle}</b></p>}
        <p class="lead">{lead}</p>
        {(hasPerformerNames || series.length > 0) && <div class="work-identity-links">
          {hasPerformerNames && <div>演員 {performers.length
            ? performers.map((performer, index) => <>{index > 0 && '、'}<a href={performer.href} data-performer-id={performer.stable_performer_id}>{performer.primary_display_name}</a></>)
            : review.data.actress.join('、')}</div>}
          {series.length > 0 && <div>系列 {series.map((item: OrderedSeriesRecord, index: number) => <>{index > 0 && '、'}<a href={item.href}>{item.display_name}</a></>)}</div>}
        </div>}
        <a class="button work-source-link" href={review.data.sourceUrl} target="_blank" rel="sponsored noopener noreferrer">{sourceLinkLabel} ↗</a>
      </div>
      <figure class="work-hero-cover">
        <img src={review.data.coverUrl} alt={`${review.data.id} 來源作品封面`} loading="eager" />
        <figcaption>來源作品封面</figcaption>
      </figure>
    </header>

    <section class="work-story" aria-label={articleLabel}>
      <div class="article-body">
        <Content />
      </div>
      <div class="work-after-article">
        <p>本作來源　<a href={review.data.sourceUrl} target="_blank" rel="sponsored noopener noreferrer">{sourceLinkLabel} ↗</a></p>
        {(performers.length > 0 || series.length > 0) && <nav aria-label="延伸閱讀">
          <strong>延伸閱讀</strong>
          {performers.map((performer: OrderedPerformerRecord) => <a href={performer.href}>看{performer.primary_display_name}的站內作品</a>)}
          {series.map((item: OrderedSeriesRecord) => <a href={item.href}>《{item.display_name}》系列入口</a>)}
        </nav>}
      </div>
    </section>

    {hasPublishedVideo && <section class="work-video" aria-labelledby="work-video-title">
      <div><p class="eyebrow">SHORT VIDEO</p><h2 id="work-video-title">本站製作的 9 秒短片</h2></div>
      <VideoPlayer src={review.data.videoUrl} poster={review.data.heroUrl ?? review.data.coverUrl} sourceUrl={review.data.sourceUrl} title={review.data.id} />
    </section>}

    <details class="work-details">
      <summary>名稱與完整作品資料</summary>
      <WorkFacts review={review} source={source} search={search} performers={performers} series={series} />
    </details>
    <EvidenceNotice evidence={evidence} />
    {review.data.heroUrl && (
      <figure class="review-hero-art">
        <img src={review.data.heroUrl} alt={`${review.data.id} 原創非露骨情境主視覺`} loading="lazy" />
        <figcaption>本站原創情境圖 · 不取代來源作品封面</figcaption>
      </figure>
    )}
    {(canonicalTags.length > 0 || rawSourceTags.length > 0 || editorialTags.length > 0) && <section class="review-tag-board" aria-label="作品標籤">
      {canonicalTags.length > 0 && <div><p class="tag-label">站內題材</p><TagList tags={canonicalTags} /></div>}
      {rawSourceTags.length > 0 && <div><p class="tag-label source-tag-label">CC18 原始標籤</p><TagList tags={rawSourceTags} /></div>}
      {editorialTags.length > 0 && <div><p class="tag-label editorial-tag-label">影評觀點</p><TagList tags={editorialTags} /></div>}
    </section>}
    <TopicElements sourceTags={review.data.sourceTags} sourceTagRelations={source?.source_relations?.tags} />
    {search && <DecisionGuide content={search} related={related} timeline={evidence.timeline} />}
  </article>
</BaseLayout>
