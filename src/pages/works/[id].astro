---
import {getCollection, render} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import WorkFacts from '../../components/WorkFacts.astro';
import DecisionGuide from '../../components/DecisionGuide.astro';
import TopicElements from '../../components/TopicElements.astro';
import {formatDate, reviewEditorialTags, visibleTags} from '../../lib/reviews';
import {sourceTagItems} from '../../lib/taxonomy';
import {sourceRecordFor} from '../../lib/source-records';
import {searchContentFor} from '../../lib/search-content';
import {reviewQualityFor} from '../../lib/review-quality';
import {loadPerformerCatalog} from '../../lib/performer-catalog.mjs';

interface OrderedPerformerRecord {
  stable_performer_id: string;
  primary_display_name: string;
  href: string;
}

export async function getStaticPaths() {
  const [reviews, performerCatalog] = await Promise.all([
    getCollection('reviews', ({data}) => data.status === 'published'),
    loadPerformerCatalog(),
  ]);
  return reviews.map((review) => ({
    params: {id: review.data.id.toLowerCase()},
    props: {
      review,
      performers: (performerCatalog.ordered_performers_by_work as Array<{
        stable_movie_id: string;
        performers: OrderedPerformerRecord[];
      }>).find(({stable_movie_id: stableMovieId}) => stableMovieId === `cc18:${review.data.id}`)?.performers ?? [],
    },
  }));
}
const {review, performers} = Astro.props;
const {Content} = await render(review);
const allReviews = await getCollection('reviews', ({data}) => data.status === 'published');
const related = new Map(allReviews.map((item) => [item.data.id, item]));
const source = sourceRecordFor(review.data.id);
const search = searchContentFor(review.data.id);
const quality = reviewQualityFor(review.data.id);
const editorialTags = reviewEditorialTags(review);
if (!quality?.approved_for_publish) throw new Error(`${review.data.id}: approved review quality record missing`);
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageUrl = new URL(review.data.heroUrl ?? review.data.coverUrl, Astro.site ?? Astro.url.origin);
const structuredData: Array<Record<string, unknown>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {'@type': 'ListItem', position: 1, name: '首頁', item: new URL('/', pageUrl).href},
      {'@type': 'ListItem', position: 2, name: '作品影評', item: new URL('/latest/', pageUrl).href},
      {'@type': 'ListItem', position: 3, name: review.data.id, item: pageUrl.href},
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: review.data.title,
    description: review.data.shortReview,
    image: imageUrl.href,
    datePublished: review.data.publishedAt.toISOString(),
    dateModified: source?.fetched_at ?? review.data.publishedAt.toISOString(),
    inLanguage: 'zh-Hant',
    mainEntityOfPage: pageUrl.href,
    author: {'@type': 'Organization', name: 'CC18 影格編輯台', url: new URL('/method/', pageUrl).href},
    publisher: {'@type': 'Organization', name: 'CC18 影格'},
    about: [review.data.id, ...review.data.actress, ...(review.data.series ? [review.data.series] : [])],
  },
];
if (review.data.videoUrl) structuredData.push({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: review.data.socialTitle,
  description: review.data.shortReview,
  thumbnailUrl: [imageUrl.href],
  uploadDate: review.data.publishedAt.toISOString(),
  duration: 'PT9S',
  contentUrl: new URL(review.data.videoUrl, pageUrl).href,
  embedUrl: pageUrl.href,
  isFamilyFriendly: false,
});
---
<BaseLayout title={review.data.seoTitle} socialTitle={review.data.socialTitle} description={review.data.shortReview} image={review.data.heroUrl ?? review.data.coverUrl} video={review.data.videoUrl} releaseId={quality.review_sha256} adult={true} structuredData={structuredData}>
  <article class="review-page">
    <nav class="breadcrumbs" aria-label="麵包屑">
      <a href="/">首頁</a><span>／</span><a href="/latest/">作品影評</a><span>／</span><b>{review.data.id}</b>
    </nav>
    <header class="watch-deck">
      <div class="watch-stage">
        <VideoPlayer src={review.data.videoUrl} poster={review.data.coverUrl} sourceUrl={review.data.sourceUrl} title={review.data.id} />
      </div>
      <div class="review-heading watch-panel">
        <div class="watch-identity">
          <img src={review.data.coverUrl} alt={`${review.data.id} 作品封面`} />
          <div><p class="eyebrow">NEW REVIEW</p><p class="hero-number">{review.data.id}</p></div>
        </div>
        <p class="hero-number">{review.data.id}</p>
        <h1>{review.data.title}</h1>
        <p class="lead">{review.data.shortReview}</p>
        <dl class="watch-meta">
          <div><dt>上片日期</dt><dd>{formatDate(review.data.releaseDate)}</dd></div>
          <div>
            <dt>演員</dt>
            <dd>{performers.length
              ? performers.map((performer, index) => <>{index > 0 && '、'}<a href={performer.href} data-performer-id={performer.stable_performer_id}>{performer.primary_display_name}</a></>)
              : review.data.actress.join('、') || '來源未列出'}</dd>
          </div>
          <div><dt>片商</dt><dd>{review.data.studio || '來源未列出'}</dd></div>
        </dl>
        <TagList tags={visibleTags(review).slice(0, 6)} />
        <a class="button source-cta" href={review.data.sourceUrl} target="_blank" rel="sponsored noopener">
          <span>完整影片與原始作品資訊</span><b>前往 CC18 播放 ↗</b>
        </a>
      </div>
    </header>
    <section class="review-tag-board" aria-label="作品標籤">
      <div><p class="tag-label">站內題材</p><TagList tags={visibleTags(review)} /></div>
      <div><p class="tag-label source-tag-label">CC18 原始標籤</p><TagList tags={sourceTagItems(review.data.sourceTags)} /></div>
      {editorialTags.length > 0 && <div><p class="tag-label editorial-tag-label">影評觀點</p><TagList tags={editorialTags} /></div>}
    </section>
    {review.data.heroUrl && (
      <figure class="review-hero-art">
        <img src={review.data.heroUrl} alt={`${review.data.id} 原創非露骨情境主視覺`} loading="eager" />
        <figcaption>CC18 影格原創情境圖 · 依作品企劃切角製作，不取代原始作品封面</figcaption>
      </figure>
    )}
    <WorkFacts review={review} source={source} search={search} performers={performers} />
    <TopicElements sourceTags={review.data.sourceTags} />
    {search && <DecisionGuide content={search} related={related} />}
    <div class="article-layout">
      <div class="article-body">
        <div class="article-kicker"><p class="eyebrow">FULL REVIEW</p><h2>完整影評</h2></div>
        <Content />
      </div>
      <aside>
        <p class="eyebrow">QUICK LINKS</p>
        <h2>繼續找片</h2>
        <p>作品資料整理自 CC18。{search?.sample_windows ? `本篇另參考 ${search.sample_windows} 個時間軸觀察窗口。` : '完整影片內容請以原始作品頁為準。'}</p>
        <a href="/method/">查看資料與編輯說明 →</a>
        <a href={review.data.sourceUrl} target="_blank" rel="sponsored noopener">開啟 CC18 原始頁面 ↗</a>
      </aside>
    </div>
  </article>
</BaseLayout>
