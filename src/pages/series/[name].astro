---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import {byNewest} from '../../lib/reviews';
export async function getStaticPaths() {
  const reviews = await getCollection('reviews', ({data}) => data.status === 'published');
  const names = [...new Set(reviews.map((r) => r.data.series).filter((name): name is string => Boolean(name)))];
  return names.map((name) => ({params: {name}, props: {name, reviews: reviews.filter((r) => r.data.series === name).sort(byNewest)}}));
}
const {name, reviews} = Astro.props;
const indexable = reviews.length >= 3;
---
<BaseLayout title={`${name}系列作品與影評`} description={`${name}系列的作品順序、人物互動與各集差異，目前收錄 ${reviews.length} 部。`} robots={indexable ? undefined : 'noindex,follow'} adult={true}><section class="page-intro"><p class="eyebrow">SERIES HUB</p><h1>{name}</h1><p>比較系列公式、人物互動與每部作品真正不同的地方。目前收錄 {reviews.length} 部；資料量足夠形成比較後才開放搜尋索引。</p></section><section class="card-grid">{reviews.map((review) => <ReviewCard review={review} />)}</section></BaseLayout>
