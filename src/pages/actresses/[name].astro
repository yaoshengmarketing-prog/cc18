---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import {byNewest} from '../../lib/reviews';
export async function getStaticPaths() {
  const reviews = await getCollection('reviews', ({data}) => data.status === 'published');
  const names = [...new Set(reviews.flatMap((r) => r.data.actress))];
  return names.map((name) => ({params: {name}, props: {name, reviews: reviews.filter((r) => r.data.actress.includes(name)).sort(byNewest)}}));
}
const {name, reviews} = Astro.props;
const indexable = reviews.length >= 3;
---
<BaseLayout title={`${name}作品與影評`} description={`${name}的最新作品、題材方向與 CC18 原創影評，目前收錄 ${reviews.length} 部。`} robots={indexable ? undefined : 'noindex,follow'} adult={true}><section class="page-intro"><p class="eyebrow">ACTRESS HUB</p><h1>{name}</h1><p>依上片日期整理的作品、題材標籤與影評切角。目前 {reviews.length} 部；收錄量足以形成獨立比較後才開放搜尋索引。</p></section><section class="card-grid">{reviews.map((review) => <ReviewCard review={review} />)}</section></BaseLayout>
