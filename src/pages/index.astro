---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MovieCardV1 from '../components/MovieCardV1.astro';
import PromoVideoCard from '../components/PromoVideoCard.astro';
import TagList from '../components/TagList.astro';
import {byNewest, formatDate, reviewHref, reviewTagIds, visibleTags} from '../lib/reviews';
import {loadLatestAddedMovieCardCatalog, loadLatestAddedPromoCatalog} from '../lib/movie-master.mjs';
import {tagItems} from '../lib/taxonomy';

const reviews = (await getCollection('reviews', ({data}) => data.status === 'published')).sort(byNewest);
const featured = reviews.find(({data}) => data.featured) ?? reviews[0];
const catalog = await loadLatestAddedMovieCardCatalog();
const promoCatalog = await loadLatestAddedPromoCatalog({limit: 3});
const tagIds = [...new Set(reviews.flatMap(reviewTagIds))].slice(0, 12);
const tags = tagItems(tagIds);
---
<BaseLayout title="最新作品影評" description="CC18 最新作品、演員、系列、題材標籤與選片觀點，快速找到完整作品入口。" adult={true}>
  <section class="catalog-lead">
    <div>
      <p class="eyebrow">NEW RELEASES</p>
      <h1>今天想看哪一部？</h1>
      <p>用番號、演員、系列或題材搜尋，也可以直接往下看最新收錄。</p>
    </div>
    <form action="/search/" method="get" role="search" class="home-search">
      <label for="home-query">搜尋作品</label>
      <div><input id="home-query" name="q" type="search" placeholder="輸入番號、演員或題材" /><button type="submit">搜尋</button></div>
    </form>
  </section>
  {featured && (
    <section class="hero catalog-feature">
      <div class="hero-art">
        <img src={featured.data.coverUrl} alt={`${featured.data.id} 作品封面`} />
        <div class="film-edge" aria-hidden="true"></div>
      </div>
      <div class="hero-copy">
        <p class="eyebrow">本週焦點 · {formatDate(featured.data.releaseDate)}</p>
        <p class="hero-number">{featured.data.id}</p>
        <h1>{featured.data.title}</h1>
        <p class="hero-review">{featured.data.shortReview}</p>
        <TagList tags={visibleTags(featured).slice(0, 4)} />
        <div class="hero-actions">
          <a class="button primary" href={reviewHref(featured)}>閱讀完整影評</a>
          <a class="button secondary" href={featured.data.sourceUrl} target="_blank" rel="sponsored noopener">前往 CC18 作品頁 ↗</a>
        </div>
        <p class="source-note">番號、日期、演員與題材一次看懂</p>
      </div>
    </section>
  )}

  <section class="reel-section">
    <div class="section-heading">
      <div><p class="eyebrow">LATEST ADDED</p><h2>最新收錄</h2></div>
      <p>依本站收錄時間排序；卡片日期為作品發行日。</p>
      <a href="/latest/">查看全部 →</a>
    </div>
    <div class="card-grid" role="list">
      {catalog.cards.map((card) => <div role="listitem"><MovieCardV1 card={card} /></div>)}
    </div>
  </section>

  <section class="promo-picks" data-promo-picks>
    <div class="section-heading promo-picks__heading">
      <div><p class="eyebrow">9-SECOND PICKS</p><h2>9秒看重點</h2></div>
      <p>9秒選片短影音為本站原創編輯視覺，不是官方預告、原片摘要或觀看證據。</p>
    </div>
    <div class="promo-picks__grid" role="list">
      {promoCatalog.cards.map((card) => <div role="listitem"><PromoVideoCard {...card} /></div>)}
    </div>
  </section>

  <section class="explore-grid">
    <div class="tag-panel">
      <p class="eyebrow">BROWSE BY TOPIC</p>
      <h2>從題材開始找</h2>
      <p>把相近用語整理成一致分類，找片時不用猜不同作品用了哪一種寫法。</p>
      <TagList tags={tags.length ? tags : tagItems(['story'])} />
      <a class="text-link" href="/tags/">瀏覽完整標籤庫 →</a>
    </div>
    <div class="editorial-panel">
      <span class="quote-mark">18+</span>
      <p>先看封面與題材，再用影評判斷這部是不是你的菜。</p>
      <small>CC18 影格選片指南</small>
    </div>
  </section>
</BaseLayout>
