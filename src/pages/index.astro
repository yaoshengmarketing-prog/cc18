---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePerformerExplore from '../components/HomePerformerExplore.astro';
import MovieCardV1 from '../components/MovieCardV1.astro';
import CatalogPagination from '../components/CatalogPagination.astro';
import {catalogPages} from '../lib/catalog-pagination.mjs';
import PromoVideoCard from '../components/PromoVideoCard.astro';
import TagList from '../components/TagList.astro';
import {reviewHref, visibleTags} from '../lib/reviews';
import {loadLatestAddedMovieCardCatalog, loadLatestAddedPromoCatalog} from '../lib/movie-master.mjs';
import {loadPublishedTopicCatalog} from '../lib/topic-catalog.mjs';
import {loadPerformerCatalog} from '../lib/performer-catalog.mjs';
import {tagItems} from '../lib/taxonomy';
import {SITE_NAME} from '../lib/site-brand.mjs';

const catalog = await loadLatestAddedMovieCardCatalog();
const reviews = await getCollection('reviews', ({data}) => data.status === 'published');
const featured = reviews.find(({data}) => data.id === catalog.cards[0]?.catalog_code);
if (!featured) throw new Error('Homepage latest published work has no published review');
const featuredHeading = featured.data.displayShortTitle
  ?? (featured.data.socialTitle.replace(new RegExp(`^${featured.data.id}\\s*[｜|:：—-]*\\s*`, 'i'), '').trim() || featured.data.title);
const featuredLead = featured.data.shortReview;
const firstPage = catalogPages(catalog.cards)[0];
const promoCatalog = await loadLatestAddedPromoCatalog({limit: 3});
const performerCatalog = await loadPerformerCatalog();
const performerCount = performerCatalog.performers.length;
if (!Number.isInteger(performerCount) || performerCount < 1) {
  throw new Error('Homepage performer exploration requires at least one catalog performer');
}
const tagIds = (await loadPublishedTopicCatalog()).slice(0, 12).map(({id}) => id);
const tags = tagItems(tagIds);
const siteUrl = new URL('/', Astro.site ?? Astro.url.origin).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  url: siteUrl,
  name: SITE_NAME,
  publisher: {'@type': 'Organization', name: SITE_NAME},
};
---
<BaseLayout title="AV 作品解析、女優介紹與系列整理" brandFirst={true} description="整理最新 AV 作品、女優、系列與題材線索，快速找到作品入口與編輯觀點。" adult={true} structuredData={structuredData}>
  <section class="catalog-lead">
    <div>
      <p class="eyebrow">NEW RELEASES</p>
      <h1>AV 作品解析、女優與系列指南</h1>
      <p>用番號、演員、系列或題材搜尋，也可以直接往下看最新收錄。</p>
    </div>
    <form action="/search/" method="get" role="search" class="home-search">
      <label for="home-query">搜尋作品</label>
      <div><input id="home-query" name="q" type="search" placeholder="輸入番號、演員或題材" /><button type="submit">搜尋</button></div>
    </form>
  </section>
  {featured && (
    <section class="hero catalog-feature">
      <div class="hero-art">
        <img src={featured.data.coverUrl} alt={`${featured.data.id} 作品封面`} />
        <div class="film-edge" aria-hidden="true"></div>
      </div>
      <div class="hero-copy">
        <p class="eyebrow">最新收錄</p>
        <p class="hero-number">{featured.data.id}</p>
        <h2>{featuredHeading}</h2>
        <p class="hero-review">{featuredLead}</p>
        <TagList tags={visibleTags(featured).slice(0, 4)} />
        <div class="hero-actions">
          <a class="button primary" href={reviewHref(featured)}>閱讀作品文章</a>
          <a class="button secondary" href={featured.data.sourceUrl} target="_blank" rel="sponsored noopener">前往 CC18 作品頁 ↗</a>
        </div>
        <p class="source-note">番號、日期、演員與題材一次看懂</p>
      </div>
    </section>
  )}

  <section class="reel-section">
    <div class="section-heading">
      <div><p class="eyebrow">LATEST ADDED</p><h2>最新收錄</h2></div>
      <p>依本站收錄時間排序；卡片日期為作品發行日。</p>
      <a href="/latest/">查看全部 →</a>
    </div>
    <div class="card-grid" role="list">
      {firstPage.cards.map((card) => <div role="listitem"><MovieCardV1 card={card} /></div>)}
    </div>
    <CatalogPagination current={1} total={firstPage.total} />
  </section>

  <section class="promo-picks" data-promo-picks>
    <div class="section-heading promo-picks__heading">
      <div><p class="eyebrow">9-SECOND PICKS</p><h2>9秒看重點</h2></div>
      <p>9秒選片短影音為本站原創編輯視覺，不是官方預告、原片摘要或觀看證據。</p>
    </div>
    <div class="promo-picks__grid" role="list">
      {promoCatalog.cards.map((card) => <div role="listitem"><PromoVideoCard {...card} /></div>)}
    </div>
  </section>

  <HomePerformerExplore count={performerCount} />

  <section class="explore-grid">
    <div class="tag-panel">
      <p class="eyebrow">BROWSE BY TOPIC</p>
      <h2>從題材開始找</h2>
      <p>把相近用語整理成一致分類，找片時不用猜不同作品用了哪一種寫法。</p>
      <TagList tags={tags} />
      <a class="text-link" href="/tags/">瀏覽完整標籤庫 →</a>
    </div>
    <div class="editorial-panel">
      <span class="quote-mark">18+</span>
      <p>先看封面與題材，再用影評判斷這部是不是你的菜。</p>
      <small>JAV 影格選片指南</small>
    </div>
  </section>
</BaseLayout>
